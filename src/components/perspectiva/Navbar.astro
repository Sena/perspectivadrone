---
const { 
  menu = [], 
  instagram = "", 
  title, 
  tagline 
} = Astro.props;

interface MenuItem {
  url: string;
  label: string;
}

const items: MenuItem[] = menu;
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-6 px-6 md:px-12">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Logo -->
    <div class="flex flex-col">
      <span class="text-white font-bold text-xl tracking-tight font-display">{title}</span>
      <span class="coord-text text-[8px] uppercase tracking-[0.2em] text-white/40">{tagline}</span>
    </div>

    <!-- Desktop Menu -->
    <div id="desktop-menu" class="hidden md:flex items-center gap-10">
      {items.map((item: MenuItem) => (
        <a 
          href={item.url} 
          class="text-sm tracking-wide text-white/70 hover:text-amber-400 transition-colors font-medium font-sans"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Social / Contact Button -->
    <div class="hidden md:flex items-center gap-6">
      <a 
        href={`https://www.instagram.com/${instagram}/`} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-2 group border border-white/10 px-4 py-2 hover:border-amber-400/30 transition-all bg-white/5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40 group-hover:text-amber-400"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        <span class="coord-text text-[9px] text-white/50 group-hover:text-white transition-colors">@{instagram}</span>
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button id="menu-toggle" class="md:hidden text-white/80 p-2">
      <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>

  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 bg-black/95 z-[60] translate-x-full transition-transform duration-500 flex flex-col items-center justify-start overflow-y-auto pt-32 pb-16 gap-8 md:hidden">
  <button id="menu-close" class="absolute top-8 right-8 text-white/60">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
  {items.map((item: MenuItem) => (
    <a href={item.url} class="text-3xl font-bold text-white hover:text-amber-400 transition-colors mobile-link font-display">
      {item.label}
    </a>
  ))}
</div>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('menu-toggle');
  const close = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('nav-scrolled');
    } else {
      navbar?.classList.remove('nav-scrolled');
    }
  });

  // Mobile menu logic
  toggle?.addEventListener('click', () => {
    mobileMenu?.classList.remove('translate-x-full');
  });

  close?.addEventListener('click', () => {
    mobileMenu?.classList.add('translate-x-full');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('translate-x-full');
    });
  });

  // Scroll Spy logic
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('#desktop-menu a, #mobile-menu a.mobile-link');

  const siteTitle = document.querySelector('title')?.textContent?.split('—')[1]?.trim() || "Perspectiva Drone";
  
  const observerOptions = {
    root: null,
    rootMargin: '-20% 0px -70% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        
        // Handle navbar highlight
        navLinks.forEach(link => {
          link.classList.remove('text-amber-400');
          link.classList.add('text-white/70');
          const href = link.getAttribute('href') || '';
          const isInicio = id === 'inicio' && (href === '/' || href === '#inicio' || href === '/#inicio');
          
          if (href === `#${id}` || href === `/#${id}` || isInicio) {
            link.classList.add('text-amber-400');
            link.classList.remove('text-white/70');
            
            // Update Title
            const label = link.textContent?.trim();
            if (label && id !== 'inicio') {
               document.title = `${label} - ${siteTitle}`;
            } else if (id === 'inicio') {
               document.title = siteTitle;
            }
            
            // Update URL
            const newUrl = id === 'inicio' ? '/' : `/${id}`;
            window.history.replaceState(null, '', newUrl);
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach(section => observer.observe(section));

  // Reveal Animation Logic
  const revealElements = document.querySelectorAll('.reveal-hidden');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, {
    root: null,
    rootMargin: '50px 0px 0px 0px',
    threshold: 0
  });

  revealElements.forEach(el => revealObserver.observe(el));

  // Smooth scroll & click intercept for nav links
  const allNavLinks = document.querySelectorAll('#desktop-menu a, #mobile-menu a');
  allNavLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      if (link.hostname && link.hostname !== window.location.hostname) return;
      
      const url = new URL(link.href, window.location.origin);
      if (url.pathname !== window.location.pathname && url.pathname !== '/') return;

      let targetId = url.hash ? url.hash.substring(1) : url.pathname.replace(/^\/|\/$/g, '');
      if (targetId === '') targetId = 'inicio';
      
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        e.preventDefault();
        targetElement.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // Handle direct navigation to sections (e.g. /contato)
  document.addEventListener('DOMContentLoaded', () => {
    const path = window.location.pathname.replace(/^\/|\/$/g, '');
    if (path && path !== '') {
      const targetElement = document.getElementById(path);
      if (targetElement) {
        // Small timeout ensures the page is fully laid out before scrolling
        setTimeout(() => targetElement.scrollIntoView({ behavior: 'smooth' }), 100);
      }
    }
  });
</script>

<style>
  .nav-scrolled {
    background: oklch(0.05 0.005 285 / 0.9);
    backdrop-filter: blur(10px);
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
</style>
