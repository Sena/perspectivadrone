---
import {
  getEmDashCollection,
  getSiteSettingsWithCacheHint,
  getEmDashEntry,
  getMenuWithCacheHint,
} from "emdash";
import Base from "../layouts/Base.astro";
import Navbar from "../components/perspectiva/Navbar.astro";
import Hero from "../components/perspectiva/Hero.astro";
import PortfolioGrid from "../components/perspectiva/PortfolioGrid.astro";
import About from "../components/perspectiva/About.astro";
import ServicesGrid from "../components/perspectiva/ServicesGrid.astro";
import ContactForm from "../components/perspectiva/ContactForm.astro";

// Fetch data
const [
  { data: settings, cacheHint: settingsCache },
  { data: menu, cacheHint: menuCache },
] = await Promise.all([
  getSiteSettingsWithCacheHint(),
  getMenuWithCacheHint("primary"),
]);

// Fetch sections
const { entry: hero, cacheHint: heroCache } = await getEmDashEntry("pages", "hero");
const { entry: about, cacheHint: aboutCache } = await getEmDashEntry("pages", "sobre");
const { entry: ctaServices, cacheHint: ctaServicesCache } = await getEmDashEntry("pages", "cta-services");
const { entry: contactInfo, cacheHint: contactCache } = await getEmDashEntry("pages", "contato");

const { entries: portfolioItems, cacheHint: portfolioCache } = await getEmDashCollection("portfolio");
const { entries: services, cacheHint: servicesCache } = await getEmDashCollection("services");

// Cache hints
Astro.cache.set(settingsCache);
Astro.cache.set(menuCache);
Astro.cache.set(heroCache);
Astro.cache.set(aboutCache);
Astro.cache.set(ctaServicesCache);
Astro.cache.set(contactCache);
Astro.cache.set(portfolioCache);
Astro.cache.set(servicesCache);

// EmDash 1.6 compartilha o array entre leituras idênticas na mesma request:
// ordenar uma cópia evita mexer no objeto que outra página ainda vai ler.
const sortedServices = [...services].sort((a, b) => (Number(a.data.sort_order) || 0) - (Number(b.data.sort_order) || 0));

const heroImg = hero?.data?.image as
  | string
  | { src?: string; id?: string; meta?: { storageKey?: unknown } }
  | null
  | undefined;
const heroMedia = typeof heroImg === 'string' ? undefined : heroImg;
const heroStorageKey =
  typeof heroMedia?.meta?.storageKey === 'string'
    ? heroMedia.meta.storageKey
    : heroMedia?.id;
const heroPreloadSrc = typeof heroImg === 'string'
  ? heroImg
  : heroMedia?.src || (heroStorageKey ? Astro.locals.emdash?.getPublicMediaUrl?.(heroStorageKey) : undefined) || null;
---

<Base title={settings.title} description={settings.tagline} preloadImage={heroPreloadSrc}>
  <div class="min-h-screen overflow-x-hidden bg-background text-white">
    <Navbar instagram={settings.social?.instagram} menu={menu?.items} title={settings.title} tagline={settings.tagline} />
    
    <main>
      <Hero 
        entry={hero} 
      />

      <PortfolioGrid items={portfolioItems}  instagram={settings.social?.instagram}/>

      <div class="amber-divider my-0 mx-6"></div>

      <About 
        entry={about}
      />

      <div class="amber-divider my-0 mx-6"></div>

      <ServicesGrid 
        services={sortedServices} 
        cta={ctaServices}
      />

      <div class="amber-divider my-0 mx-6"></div>

      <ContactForm 
        instagram={settings.social?.instagram}
        entry={contactInfo}
      />
    </main>

    <footer class="border-t border-white/10 py-10 px-6">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-white font-bold text-lg font-display">{settings.title}</p>
          <p class="coord-text mt-1 text-white/60">{settings.tagline}</p>
        </div>
        <p class="coord-text text-white/50">
          © {new Date().getFullYear()} {settings.title} · Todos os direitos reservados
        </p>
      </div>
    </footer>
  </div>
</Base>
