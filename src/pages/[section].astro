---
const { section } = Astro.params;
const validSections = ['portfolio', 'sobre', 'servicos', 'contato'];

if (!validSections.includes(section || '')) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}

// Rewrite the request to the home page so the URL stays clean without a hashtag redirect flash
return Astro.rewrite('/');
---
