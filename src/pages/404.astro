---
import { getSiteSettings, getMenu } from "emdash";
import Base from "../layouts/Base.astro";
import Navbar from "../components/perspectiva/Navbar.astro";

const settings = await getSiteSettings();
const menu = await getMenu("primary");
---

<Base title={`Página não encontrada — ${settings.title}`} description="A página que você procura não existe.">
  <div class="min-h-screen overflow-x-hidden bg-background text-white flex flex-col">
    <Navbar instagram={settings.social?.instagram} menu={menu?.items} title={settings.title} tagline={settings.tagline} />
    
    <main class="flex-grow flex items-center justify-center pt-32 pb-16 px-6">
      <div class="text-center max-w-2xl">
        <p class="coord-text mb-4 text-primary">/ 404 — ERRO</p>
        <h1 class="text-6xl md:text-8xl font-bold text-white mb-6 font-display">
          Fora de <span class="italic text-primary">foco</span>
        </h1>
        <p class="text-white/60 text-lg md:text-xl font-sans font-light mb-10 leading-relaxed">
          A página que você tentou acessar não foi encontrada no nosso radar. O link pode estar quebrado ou a página foi movida.
        </p>
        <a href="/" class="inline-flex items-center gap-2 px-8 py-3 border border-primary/40 text-sm font-medium transition-all text-primary font-sans hover:bg-primary hover:text-black">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Voltar para o Início
        </a>
      </div>
    </main>

    <footer class="border-t border-white/10 py-10 px-6 mt-auto">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-white font-bold text-lg font-display">{settings.title}</p>
          <p class="coord-text mt-1 text-white/30">{settings.tagline}</p>
        </div>
        <p class="coord-text text-white/20">
          © {new Date().getFullYear()} {settings.title} · Todos os direitos reservados
        </p>
      </div>
    </footer>
  </div>
</Base>
