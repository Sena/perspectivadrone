---
import { getSiteSettingsWithCacheHint } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { shouldLoadAnalytics } from "../utils/analytics-gate";
import "../styles/theme.css";

// Prevenir cache do HTML para evitar CSS quebrado (hash antigo) após novos deploys
Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=0, must-revalidate"
);

// HSTS, XFO, nosniff, Referrer-Policy, Permissions-Policy e CSP vivem no
// `src/middleware.ts`: lá eles alcançam também robots.txt, sitemap e /uploads,
// que não passam por este layout.


interface Props {
	title?: string;
	description?: string | null;
	image?: string | null;
	preloadImage?: string | null;
	type?: "website" | "article";
	/** `false` desliga os hints de cache do layout (ex.: página 404). */
	cache?: boolean;
}

const {
	title = "",
	description,
	image,
	preloadImage,
	type = "website",
	cache = true,
} = Astro.props;

const { data: settings, cacheHint: settingsCache } =
	await getSiteSettingsWithCacheHint();
// Resposta de sessão não pode virar cache público.
const hasUser = Boolean(
	(Astro.locals as unknown as { user?: unknown }).user,
);
if (cache && !hasUser) Astro.cache.set(settingsCache);

// GA4 só no host canônico de produção e sem sessão. Preview, dev e admin ficam
// de fora; `GA_ENABLED=false` é o kill switch.
const analyticsEnabled = shouldLoadAnalytics({
	host: Astro.url.host,
	canonicalHost: Astro.site?.host ?? null,
	isProd: import.meta.env.PROD,
	hasUser: Boolean((Astro.locals as unknown as { user?: unknown }).user),
	enabled:
		typeof process !== "undefined"
			? (process.env as Record<string, string | undefined>)?.GA_ENABLED !==
				"false"
			: true,
});

const { siteTitle } = resolveBlogSiteIdentity(settings);
const fullTitle = title && title.includes(siteTitle) ? title : (title ? `${title} — ${siteTitle}` : siteTitle);

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title,
	description,
	image,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<!-- Fontes baixadas no build e servidas pelo próprio domínio (API de Fonts do Astro) -->
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
		{preloadImage && (
			<link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
		)}
		{analyticsEnabled && (
			<>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());

					gtag('config', 'G-RJDVRMXRM6');
				</script>
				<script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=G-RJDVRMXRM6"></script>
			</>
		)}
		<noscript>
			<style>
				.reveal-hidden,
				.gsap-card,
				.gsap-reveal {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class="grain-overlay">
		<EmDashBodyStart page={pageCtx} />
		
		<slot />

		<EmDashBodyEnd page={pageCtx} />



	</body>
</html>
