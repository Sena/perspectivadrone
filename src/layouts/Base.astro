---
import { getSiteSettingsWithCacheHint } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

// Prevenir cache do HTML para evitar CSS quebrado (hash antigo) após novos deploys
Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=0, must-revalidate"
);

// Forçar HTTPS (HSTS)
Astro.response.headers.set(
	"Strict-Transport-Security",
	"max-age=31536000; includeSubDomains; preload"
);

// Domínios permitidos para o CSP
const cspDomains = {
	scripts: [
		"https://www.googletagmanager.com", 
		"https://cdn.jsdelivr.net",
		"https://static.cloudflareinsights.com",
		],
	images: [
		"https://www.google-analytics.com",
		"https://www.googletagmanager.com",
		],
	connects: [
		"https://www.google-analytics.com",
		"https://analytics.google.com",
		"https://stats.g.doubleclick.net",
		"https://cloudflareinsights.com",
	],
};

// CSP restrito ao próprio domínio com exceções explícitas (via cspDomains)
// O 'nonce' foi removido porque anula o 'unsafe-inline', quebrando scripts nativos do Astro
Astro.response.headers.set(
	"Content-Security-Policy",
	`default-src 'self'; script-src 'self' 'unsafe-inline' ${cspDomains.scripts.join(" ")}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${cspDomains.images.join(" ")}; font-src 'self' data:; connect-src 'self' ${cspDomains.connects.join(" ")};`
);

interface Props {
	title?: string;
	description?: string | null;
	image?: string | null;
	type?: "website" | "article";
}

const {
	title = "",
	description,
	image,
	type = "website",
} = Astro.props;

const { data: settings, cacheHint: settingsCache } =
	await getSiteSettingsWithCacheHint();
Astro.cache.set(settingsCache);
const { siteTitle } = resolveBlogSiteIdentity(settings);
const fullTitle = title && title.includes(siteTitle) ? title : (title ? `${title} — ${siteTitle}` : siteTitle);

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title,
	description,
	image,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<!-- Fontes baixadas no build e servidas pelo próprio domínio (API de Fonts do Astro) -->
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RJDVRMXRM6"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-RJDVRMXRM6');
		</script>
		<noscript>
			<style>
				.reveal-hidden,
				.gsap-card,
				.gsap-reveal {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class="grain-overlay">
		<EmDashBodyStart page={pageCtx} />
		
		<slot />

		<EmDashBodyEnd page={pageCtx} />



	</body>
</html>
