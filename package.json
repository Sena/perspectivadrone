{
	"name": "perspectivadrone",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"typecheck": "astro check",
		"bootstrap": "emdash init && emdash seed",
		"seed": "emdash seed seed/seed.json --remote --url http://localhost:4321",
		"cleanup": "node scripts/cleanup.js",
		"cleanup:prod": "node scripts/cleanup.js --remote",
		"deploy:prod": "astro build && wrangler deploy && npx emdash seed seed/seed.json --remote"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.5.4",
		"@astrojs/react": "^5.0.5",
		"@emdash-cms/cloudflare": "^0.14.0",
		"@emdash-cms/plugin-forms": "^0.2.2",
		"astro": "^6.3.7",
		"emdash": "^0.14.0",
		"react": "19.2.6",
		"react-dom": "19.2.6"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@cloudflare/workers-types": "^4.20260522.1",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/vite": "^4.3.0",
		"tailwindcss": "^4.3.0",
		"wrangler": "^4.94.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
