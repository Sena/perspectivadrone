{
	"name": "perspectivadrone",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"typecheck": "astro check",
		"bootstrap": "emdash init && emdash seed",
		"seed": "emdash seed seed/seed.json --remote --url http://localhost:4321",
		"cleanup": "node scripts/cleanup.js",
		"cleanup:prod": "node scripts/cleanup.js --remote",
		"sync": "npx --yes github:Sena/emdash-sync-cli",
		"deploy:prod": "astro build && wrangler deploy && npx emdash seed seed/seed.json --remote"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.1",
		"@astrojs/react": "^6.0.5",
		"@emdash-cms/cloudflare": "^1.3.0",
		"@emdash-cms/plugin-forms": "^0.2.10",
		"astro": "^7.3.2",
		"emdash": "^1.3.0",
		"react": "19.2.6",
		"react-dom": "19.2.6"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@cloudflare/workers-types": "^5.20260820.1",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/vite": "^4.3.0",
		"better-sqlite3": "^13.0.3",
		"tailwindcss": "^4.3.0",
		"wrangler": "^4.125.0"
	}
}
